{
  "name": "nuxt-swa-docs",
  "private": true,
  "version": "1.0.1",
  "description": "Nuxt SWA module documentation and playground",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare": "pnpm -C ../packages/nuxt-swa prepare:docs && nuxi prepare",
    "dev": "nuxi dev",
    "build": "nuxi build && node -e \"fs.renameSync('./staticwebapp.config.json', './.output/public/staticwebapp.config.json')\"",
    "test:types": "nuxi typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.153",
    "@iconify-json/simple-icons": "^1.2.102",
    "@iconify-json/vscode-icons": "^1.2.97",
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.12.0",
    "@takumi-rs/core": "^2.19.0",
    "better-sqlite3": "^13.0.3",
    "nuxt": "^4.6.4",
    "nuxt-llms": "^0.3.1",
    "nuxt-og-image": "^7.0.7",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "nuxt-applicationinsights": "^1.0.2",
    "nuxt-swa": "workspace:*",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
