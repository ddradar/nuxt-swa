{
  "name": "nuxt-swa-docs",
  "private": true,
  "version": "1.0.1",
  "description": "Nuxt SWA module documentation and playground",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare": "pnpm -C ../packages/nuxt-swa prepare:docs && nuxi prepare",
    "dev": "nuxi dev",
    "build": "nuxi build && node -e \"fs.renameSync('./staticwebapp.config.json', './.output/public/staticwebapp.config.json')\"",
    "test:types": "nuxi typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.124",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/vscode-icons": "^1.2.74",
    "@nuxt/content": "3.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.10.0",
    "@takumi-rs/core": "^2.9.0",
    "better-sqlite3": "^12.11.1",
    "nuxt": "^4.5.2",
    "nuxt-llms": "0.2.0",
    "nuxt-og-image": "^6.7.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "nuxt-applicationinsights": "^1.0.2",
    "nuxt-swa": "workspace:*",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.10"
  }
}
